# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin

# Feature flags (M2+)
# Tool Parser v2: off (default) | shadow | enforce
# - off: Use legacy parser (default, safe)
# - shadow: Run both parsers, log differences, use legacy output
# - enforce: Use new parser v2 (after validation)
# DS2API_PARSER_V2=off

# Context Engine: off (default) | shadow | enforce
# - off: Use legacy prompt assembly (default, safe)
# - shadow: Run both engines, log ContextPlan, use legacy output
# - enforce: Use new context engine (after validation)
# DS2API_CONTEXT_ENGINE=off
